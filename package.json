{
  "name": "mem0-decay",
  "version": "0.1.0",
  "description": "Time-aware ranking and scoped lifecycle management wrapper for Mem0 OSS (v3.3.1) and Qdrant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/qdrant.integration.test.ts",
    "test:integration": "vitest run test/qdrant.integration.test.ts"
  },
  "peerDependencies": {
    "mem0ai": "3.3.1",
    "@qdrant/js-client-rest": "^1.13.0"
  },
  "peerDependenciesMeta": {
    "mem0ai": {
      "optional": true
    },
    "@qdrant/js-client-rest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.13.0",
    "@types/node": "^22.10.0",
    "mem0ai": "3.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
