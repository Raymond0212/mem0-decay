FROM python:3.12-slim

WORKDIR /app
RUN mkdir -p /app/history
RUN pip install --no-cache-dir "spacy>=3.7,<4" "fastembed>=0.3.1,<1" \
    && python -m spacy download en_core_web_sm
COPY pyproject.toml README.md ./
COPY mem0_decay/ mem0_decay/
RUN pip install --no-cache-dir '.[server]'

EXPOSE 8000
CMD ["uvicorn", "mem0_decay.server:app", "--host", "0.0.0.0", "--port", "8000"]
